# Settings for scripts/console-share.ps1. Copy to .env.console (git ignores it) and fill in.
# Every step is in docs/console-share.md and docs/console-sign-in.md.

# The dev tunnel, from 'devtunnel create', and its https address for port 8765,
# from 'devtunnel show <id>'.
CTI_TUNNEL_ID=
CTI_CONSOLE_URL=https://

# The Entra ID app (or Cognito app client) the console signs people in with.
CTI_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
CTI_OIDC_CLIENT_ID=
CTI_OIDC_CLIENT_SECRET=
# roles for Entra ID app roles, cognito:groups for Cognito.
CTI_OIDC_GROUPS_CLAIM=roles

# Signs the session cookie. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CTI_SESSION_SECRET=
