# Keep secrets, local state and build noise out of the image. A local `docker build`
# would otherwise copy .env (API keys, Claude token) and out/ (deliverables) into it.
.git
.env
.env.*
!.env.example
out/
logs/
# The console's companies: stakeholders and reports. A run is given its brand with
# a read only mount instead (scripts/run-local.*).
data/
*.log
__pycache__/
.venv/
.ruff_cache/
deploy/aws/generated/
deploy/azure/generated/

# The local console is not part of the pipeline image.
console/
