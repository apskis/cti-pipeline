# Copy to .env (gitignored, and excluded from the image by .dockerignore) and fill in.
# Read by scripts/run-local.sh and scripts/run-local.ps1 via `docker run --env-file`.
# Format is plain KEY=value: no quotes, no `export`.

# From `claude setup-token` (Max or Pro plan). Runs bill your plan, not AWS.
CLAUDE_CODE_OAUTH_TOKEN=

# Free keys for the public feeds. Leave a line empty to skip that source.
NVD_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=

# Fixed for local runs; change ANTHROPIC_MODEL to sonnet to stretch plan limits.
MODEL_BACKEND=subscription
ANTHROPIC_MODEL=opus
CLOUD=local

# Optional. Builder passes per run (default 2, four items each, on Haiku). Raise it to
# clear a backlog in one run; whatever is left over stays pending for the next run.
# BUILD_PASSES=2
